# =============================================================================
# RoomSpa — Vercel Production env IMPORT
# =============================================================================
# LOCATION:  env/VERCEL_IMPORT.production.env
# HOW TO USE:
#   1. Fill in every REPLACE_ME value below (Resend API key at minimum).
#   2. Vercel → room-spa → Settings → Environment Variables → Import .
#   3. Choose this file, apply to Production (and Preview if you want).
#   4. Redeploy Production.
#
# SAFE: This file only has NEW / email / domain vars.
#        It does NOT include Supabase or Stripe (already on Vercel — leave them).
# =============================================================================


# -----------------------------------------------------------------------------
# 1) PUBLIC SITE URL  (Stripe redirects, sitemap, emails)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.getroomspa.com


# -----------------------------------------------------------------------------
# 2) YOUR DOMAIN INBOXES  (Cloudflare Email Routing → your Gmail)
#     hello   = public / website contact
#     booking = new booking alerts (BCC copy of guest confirmation)
#     support = guest replies / help
#     admin   = internal / ops
# -----------------------------------------------------------------------------
EMAIL_HELLO=hello@getroomspa.com
EMAIL_BOOKING=booking@getroomspa.com
EMAIL_SUPPORT=support@getroomspa.com
EMAIL_ADMIN=admin@getroomspa.com


# -----------------------------------------------------------------------------
# 3) HOW OUTBOUND MAIL APPEARS  (Resend “From” + reply target)
#     Guests see From: RoomSpa <hello@…>
#     When they hit Reply, it goes to support@…
# -----------------------------------------------------------------------------
EMAIL_FROM=RoomSpa <hello@getroomspa.com>
EMAIL_REPLY_TO=support@getroomspa.com


# -----------------------------------------------------------------------------
# 4) RESEND  (sends booking confirmation + PIN)
#     Get key: https://resend.com → API Keys
#     Domain getroomspa.com must be Verified in Resend first.
# -----------------------------------------------------------------------------
RESEND_API_KEY=REPLACE_ME_RESEND_API_KEY


# -----------------------------------------------------------------------------
# 5) BOOKING CAPACITY  (therapists per time slot)
# -----------------------------------------------------------------------------
BOOKING_SLOT_CAPACITY=3
