# Environment variables
# Copy to `.env.local` and fill in values. Never commit secrets.

# Public site URL (used for sitemap, Open Graph, canonicals, Stripe redirects)
# Local: http://localhost:3000
# Production: https://www.getroomspa.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Phase 1 — booking, CMS, storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-side API utilities (for @supabase/server “Build APIs” option)
# Use only in server runtimes. Never expose to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Stripe (Phase 2)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRODUCT_SWEDISH=
NEXT_PUBLIC_STRIPE_PRICE_SWEDISH=
NEXT_PUBLIC_STRIPE_PRODUCT_COUPLES=
NEXT_PUBLIC_STRIPE_PRICE_COUPLES=

# Booking capacity (therapists available per time slot)
BOOKING_SLOT_CAPACITY=3

# Email — Resend (booking confirmations + PIN)
# Full Vercel import file: env/VERCEL_IMPORT.production.env
RESEND_API_KEY=
EMAIL_FROM=RoomSpa <hello@getroomspa.com>
EMAIL_REPLY_TO=support@getroomspa.com
EMAIL_HELLO=hello@getroomspa.com
EMAIL_BOOKING=booking@getroomspa.com
EMAIL_SUPPORT=support@getroomspa.com
EMAIL_ADMIN=admin@getroomspa.com

# Maps / analytics (optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
